--- !u!114 &695784830
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 695784829}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45161d1b1dccac44087f2f43ea7207a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LittleEmber.World.Talkable
  dialogue: {fileID: 452306799}
  npc: {fileID: 695784833}
  lines:
  - speaker: Elder Mara
    portrait: {fileID: 21300000, guid: a7879913b9ae53448ab97feabf8b43c0, type: 3}
    text: "Ah, little ember. Come in, come in \u2014 the lanterns are hung, and the whole village smells of cedar and honey."
  - speaker: Elder Mara
    portrait: {fileID: 21300000, guid: a7879913b9ae53448ab97feabf8b43c0, type: 3}
    text: "Tomorrow night we light the Kindling Flame. The same flame your mother carried, once \u2014 before the cold crept back over the ridge."
  - speaker: Pip
    portrait: {fileID: 21300000, guid: 2b0648aa0e5ffb54a9024471d869913d, type: 3}
    text: "I'll keep it burning, Elder. Brighter than ever \u2014 promise."
  - speaker: Elder Mara
    portrait: {fileID: 21300000, guid: a7879913b9ae53448ab97feabf8b43c0, type: 3}
    text: I know you will, child. But mind the old paths when you wander. The dark has been... restless this year.
