--- !u!114 &2071553407
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2071553406}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a92c6cfd297dec745ba194ff929bf17d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LittleEmber.Cine.CinematicPlayer
  slotA: {fileID: 1467526594}
  slotB: {fileID: 1335760107}
  foreA: {fileID: 2088646814}
  foreB: {fileID: 2088268469}
  backA: {fileID: 1375593031}
  backB: {fileID: 1901012809}
  panels:
  - image: {fileID: 21300000, guid: ac47edb20e076d94cb99a5c1c5ade8ee, type: 3}
    vo: {fileID: 8300000, guid: 6742ae78a70eb1e44942f4fe24105725, type: 3}
    text: Long ago, the world was warm, and every hearth burned bright with the First Flame.
    zoomFrom: 1.03
    zoomTo: 1.12
    panFrom: {x: -28, y: 12}
    panTo: {x: 28, y: -12}
  - image: {fileID: 21300000, guid: ac784ad97c5cf824399d85bf66dfcbf6, type: 3}
    vo: {fileID: 8300000, guid: 4a1bfde3403824546bf7a8007585a7a0, type: 3}
    text: In the village of Emberholt, the Kindling Festival was one sleep away.
    zoomFrom: 1.03
    zoomTo: 1.12
    panFrom: {x: 24, y: -16}
    panTo: {x: -24, y: 16}
  - image: {fileID: 21300000, guid: 2813fd57f6b188642aa863e4688a8573, type: 3}
    vo: {fileID: 8300000, guid: bb72b05e626f95f458db05c2e5b47a79, type: 3}
    text: But on that night, something ancient stirred beneath the roots of the world.
    zoomFrom: 1.03
    zoomTo: 1.12
    panFrom: {x: -28, y: 12}
    panTo: {x: 28, y: -12}
  - image: {fileID: 21300000, guid: e35f62a8535b29e48902586796922d52, type: 3}
    vo: {fileID: 8300000, guid: 63213663d1f4c604281a18af295e3f22, type: 3}
    text: The Prince of Dusk has returned, and he is gathering every last light for himself.
    zoomFrom: 1.03
    zoomTo: 1.12
    panFrom: {x: 24, y: -16}
    panTo: {x: -24, y: 16}
  - image: {fileID: 21300000, guid: a155c29894961114b9d80e087b76ebf1, type: 3}
    vo: {fileID: 8300000, guid: 902899d889c5fcf43a5100083667d396, type: 3}
    text: One by one, the Everflames went out. The cold crept in, and the dark learned to walk.
    zoomFrom: 1.03
    zoomTo: 1.12
    panFrom: {x: -28, y: 12}
    panTo: {x: 28, y: -12}
  - image: {fileID: 21300000, guid: 8304a36a7b01d954b8e7122b9b8d5bac, type: 3}
    vo: {fileID: 8300000, guid: 6a84a3f4fdcd27747afeacb7dbd11762, type: 3}
    text: "Now only one lantern still burns \u2014 and it was entrusted to the smallest hands in the village."
    zoomFrom: 1.03
    zoomTo: 1.12
    panFrom: {x: 24, y: -16}
    panTo: {x: -24, y: 16}
  - image: {fileID: 21300000, guid: 1095c269621c7244693086f26c51931b, type: 3}
    vo: {fileID: 8300000, guid: 19894f6de88ed9049a6777b0be39d98c, type: 3}
    text: Keep it lit, little ember. Carry it far. The dawn is counting on you.
    zoomFrom: 1.14
    zoomTo: 1.02
    panFrom: {x: -28, y: 12}
    panTo: {x: 28, y: -12}
  caption: {fileID: 57720433}
  skipButton: {fileID: 808690604}
  nextScene: Emberholt_Village
  charsPerSecond: 42
