  m_Script: {fileID: 11500000, guid: 45161d1b1dccac44087f2f43ea7207a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LittleEmber.World.Talkable
  dialogue: {fileID: 1762702040}
  npc: {fileID: 215187411}
  lines:
  - speaker: Bram
    portrait: {fileID: 21300000, guid: 3d22ae13c3600734c8f1de3f1b47bce1, type: 3}
    text: Evening, Pip! Stalls are stocked, barrels rolled out. All that's left is the Kindling Flame.
  - speaker: Pip
    portrait: {fileID: 21300000, guid: 2b0648aa0e5ffb54a9024471d869913d, type: 3}
    text: It'll be the brightest one yet, Bram. Wait and see.
