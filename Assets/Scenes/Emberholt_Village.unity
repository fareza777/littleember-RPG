  m_Script: {fileID: 11500000, guid: 45161d1b1dccac44087f2f43ea7207a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LittleEmber.World.Talkable
  dialogue: {fileID: 1762702040}
  npc: {fileID: 174028913}
  lines:
  - speaker: Lin
    portrait: {fileID: 21300000, guid: 3d93abfda91839e4f80324bb879cfc72, type: 3}
    text: I strung every lantern myself. At dusk the square looks like a sky full of embers, doesn't it?
  - speaker: Lin
    portrait: {fileID: 21300000, guid: 3d93abfda91839e4f80324bb879cfc72, type: 3}
    text: Elder Mara was asking after you, by the way. Her door's the big house at the west end.
