  m_Script: {fileID: 11500000, guid: 45161d1b1dccac44087f2f43ea7207a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LittleEmber.World.Talkable
  dialogue: {fileID: 1762702040}
  npc: {fileID: 1328100474}
  lines:
  - speaker: Wren
    portrait: {fileID: 21300000, guid: 3d93abfda91839e4f80324bb879cfc72, type: 3}
    text: The pond's been still as glass all week. Even the fish are waiting for the festival, I think.
  - speaker: Pip
    portrait: {fileID: 21300000, guid: 2b0648aa0e5ffb54a9024471d869913d, type: 3}
    text: Or they're just shy, Wren. Like someone I know.
